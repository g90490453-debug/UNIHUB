# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Security & Authentication
JWT_SECRET="change_this_to_a_strong_random_secret_in_production"
JWT_EXPIRES_IN="7d"

# MongoDB Connection (Optional in preview; uses persistent disk-backed Mongoose-compatible store when omitted)
MONGODB_URI=""

# Razorpay Payment Gateway (Indian Payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email Service (Nodemailer SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="UNIHUB Academic <noreply@unihub.edu>"

# File Upload Limits
MAX_UPLOAD_MB=15
